# ==================================================
# Quantheonix AI Chatbot
# Self-Hosted Deployment
# ==================================================

# --------------------------------------------------
# PostgreSQL
# --------------------------------------------------

# Choose a strong password.
POSTGRES_PASSWORD=replace_with_a_strong_database_password


# --------------------------------------------------
# Gemini AI
# --------------------------------------------------

GEMINI_API_KEY=replace_with_your_gemini_api_key

GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.7


# --------------------------------------------------
# JWT Authentication
# --------------------------------------------------

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"

JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# --------------------------------------------------
# CORS
# --------------------------------------------------

# Replace these with the actual frontend origins
# that will use @quantheonix/chatbot.

CORS_ORIGINS=["http://localhost:5173"]


# --------------------------------------------------
# Rate Limiting
# --------------------------------------------------

RATE_LIMIT_ENABLED=true

RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_REGISTER_REQUESTS=5
RATE_LIMIT_REFRESH_REQUESTS=30
RATE_LIMIT_CHAT_REQUESTS=20

RATE_LIMIT_WINDOW_SECONDS=60