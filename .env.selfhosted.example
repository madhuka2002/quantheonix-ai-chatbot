# ==================================================
# Quantheonix AI Chatbot
# Self-Hosted Deployment
# ==================================================

# --------------------------------------------------
# PostgreSQL
# --------------------------------------------------

POSTGRES_DB=quantheonix_chatbot
POSTGRES_USER=quantheonix_user
# Required. Use a long, URL-safe value because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=


# --------------------------------------------------
# Gemini AI
# --------------------------------------------------

# Optional. Used only by explicitly grandfathered Gemini assistants.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.7

# Required. Generate independently from JWT_SECRET_KEY and keep it stable.
PROVIDER_KEY_ENCRYPTION_SECRET=


# --------------------------------------------------
# JWT Authentication
# --------------------------------------------------

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"

JWT_SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# --------------------------------------------------
# CORS
# --------------------------------------------------

# Same-origin dashboard traffic is proxied and does not need CORS. Add only
# separate browser applications that call the API directly.

CORS_ORIGINS=[]

# Host port for the dashboard. PostgreSQL and FastAPI are not published.
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8080


# --------------------------------------------------
# Rate Limiting
# --------------------------------------------------

RATE_LIMIT_ENABLED=true

RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_REGISTER_REQUESTS=5
RATE_LIMIT_REFRESH_REQUESTS=30
RATE_LIMIT_CHAT_REQUESTS=20

RATE_LIMIT_WINDOW_SECONDS=60
