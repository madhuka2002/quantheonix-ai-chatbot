# Local Docker Compose configuration. Copy this file to .env.
# These are development-only values. Configure a provider key in AI Settings,
# or retain the optional fallback for grandfathered Gemini assistants below.
POSTGRES_DB=quantheonix_chatbot
POSTGRES_USER=quantheonix_user
POSTGRES_PASSWORD=user123

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.7

# Encrypts assistant-owned provider keys stored in PostgreSQL.
PROVIDER_KEY_ENCRYPTION_SECRET=local_only_provider_encryption_secret_change_me

JWT_SECRET_KEY=local_only_jwt_secret_change_before_sharing
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
RATE_LIMIT_ENABLED=true

# Optional host bindings. These defaults match compose.yaml.
POSTGRES_BIND_ADDRESS=0.0.0.0
POSTGRES_PORT=5433
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8000
DASHBOARD_BIND_ADDRESS=0.0.0.0
DASHBOARD_PORT=8080
