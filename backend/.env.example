# --------------------------------------------------
# Quantheonix AI Chatbot Backend
# Example environment configuration
# --------------------------------------------------

# Application
APP_NAME=Quantheonix AI Chatbot API
APP_VERSION=0.3.0
DEBUG=false
API_V1_PREFIX=/api/v1

# --------------------------------------------------
# Gemini
# --------------------------------------------------

# Create your own Gemini API key.
# Never expose this value in the frontend application.
GEMINI_API_KEY=your_gemini_api_key

GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.7

# --------------------------------------------------
# PostgreSQL
# --------------------------------------------------

# PostgreSQL runs on the same computer as the
# backend when the backend is NOT running in Docker.
DATABASE_URL=postgresql+asyncpg://quantheonix_user:change_me@localhost:5432/quantheonix_chatbot

# --------------------------------------------------
# JWT Authentication
# --------------------------------------------------

# Generate a secure JWT secret before running
# the application.
#
# Example generator:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_with_a_long_random_secret

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------------------------------------
# CORS
# --------------------------------------------------

# Add only frontend origins that are allowed to
# communicate with this backend.

# Local Vite development:
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Example production configuration:
# CORS_ORIGINS=["https://example.com","https://www.example.com"]

# --------------------------------------------------
# Rate Limiting
# --------------------------------------------------

RATE_LIMIT_ENABLED=true

RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_REGISTER_REQUESTS=5
RATE_LIMIT_REFRESH_REQUESTS=30
RATE_LIMIT_CHAT_REQUESTS=20

RATE_LIMIT_WINDOW_SECONDS=60