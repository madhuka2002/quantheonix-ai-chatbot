# --------------------------------------------------
# Quantheonix AI Chatbot Backend
# Docker environment example
# --------------------------------------------------

# Application
APP_NAME=Quantheonix AI Chatbot API
APP_VERSION=0.3.0
DEBUG=false
API_V1_PREFIX=/api/v1

# --------------------------------------------------
# Gemini
# --------------------------------------------------

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.7

# --------------------------------------------------
# PostgreSQL
# --------------------------------------------------

# Use this configuration when:
#
# - Quantheonix backend runs inside Docker
# - PostgreSQL runs directly on the host computer
#
# Docker Desktop provides host.docker.internal
# for accessing the host from a container.

DATABASE_URL=postgresql+asyncpg://quantheonix_user:change_me@host.docker.internal:5432/quantheonix_chatbot

# --------------------------------------------------
# JWT Authentication
# --------------------------------------------------

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------------------------------------
# CORS
# --------------------------------------------------

# Local Vite + Docker frontend examples.

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]

# Production example:
# CORS_ORIGINS=["https://example.com"]

# --------------------------------------------------
# Rate Limiting
# --------------------------------------------------

RATE_LIMIT_ENABLED=true

RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_REGISTER_REQUESTS=5
RATE_LIMIT_REFRESH_REQUESTS=30
RATE_LIMIT_CHAT_REQUESTS=20

RATE_LIMIT_WINDOW_SECONDS=60